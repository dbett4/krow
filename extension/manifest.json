{
  "manifest_version": 3,
  "name": "Krow",
  "version": "0.1.0",
  "description": "Inspect Workiva cell values and their sources, review workbook findings, and preview narrow repairs.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Krow for Workiva",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "setup.html",
    "open_in_tab": true
  },
  "permissions": [
    "alarms",
    "storage",
    "debugger"
  ],
  "host_permissions": [
    "http://127.0.0.1:8770/*",
    "http://localhost:8770/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://app.wdesk.com/*",
        "https://*.wdesk.com/*",
        "https://*.workiva.com/*"
      ],
      "js": [
        "krow-core.js",
        "krow-inspector.js",
        "krow-connection.js",
        "krow-panel.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon128.png",
        "fonts/geist-latin-wght-normal.woff2",
        "fonts/geist-mono-latin-wght-normal.woff2"
      ],
      "matches": [
        "https://*.wdesk.com/*",
        "https://*.workiva.com/*"
      ]
    }
  ]
}
