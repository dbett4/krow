# local secrets/config — holds Workiva creds, never commit. Created by ./setup.sh.
.env
.env.local
extension/local-config.js

# signing key — SECRET, never commit
*.pem
# build artifacts (regenerate via PACKAGING.md)
*.crx
*.zip
# live capture / debug images (may contain client pixels)
live_capture*.png
# Krow activity logs — runtime telemetry, may reflect client workbook structure.
# Default lives at ~/.krow/logs (outside the repo); these guard a repo-local override.
.krow/
/logs/
krow-events-*.jsonl
# scratch logo/render images at repo root only — root-anchored so
# extension/icons/ and assets/ stay tracked. Loose images at root are scratch.
/*.png
/*.svg
__pycache__/
.pytest_cache/
.lazyweb/
.venv/
.amp/portals/*

# macOS
.DS_Store

# regenerable Web Store bundle — rebuild via extension/PACKAGING.md
krow-extension.zip
