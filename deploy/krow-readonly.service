[Unit]
Description=Krow private read-only connection service
After=network.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=krow
StateDirectoryMode=0700
WorkingDirectory=/opt/krow/current/server
ExecStart=/usr/bin/python3 -B /opt/krow/current/server/app.py
LoadCredential=krow-token:/etc/krow/token
Environment=KROW_TOKEN_FILE=%d/krow-token
Environment=KROW_READ_ONLY=1 KROW_PORT=8770
Environment=HOME=/var/lib/krow KROW_LOG_DIR=/var/lib/krow/logs
Environment=PATH=/usr/bin:/bin PYTHONUNBUFFERED=1
UnsetEnvironment=KROW_TOKEN WORKIVA_CLIENT_ID WORKIVA_CLIENT_SECRET
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Connection-only commissioning. Workiva egress needs a separately approved scope.
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
